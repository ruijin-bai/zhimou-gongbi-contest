# 复制为 .env 后填写。.env 不进入 Git。
# 交融大模型（必填，内部数据只发往交融）
ZB_AI_PROVIDER=jiaorong
ZB_AI_API_KEY=
# 多个 Key 用逗号分隔，首次启动导入后台“模型与额度”（之后以后台为准）
ZB_AI_API_KEYS=
ZB_AI_BASE_URL=https://c4ai.ccccltd.cn/api/compatible/v1
ZB_AI_VISION_MODEL=jiaorong-qwen3-vl-32b-instruct
# 文本模型可与视觉模型相同；如交融提供更快的文本模型可在此替换
ZB_AI_TEXT_MODEL=jiaorong-qwen3-vl-32b-instruct
ZB_AI_TIMEOUT=180
# 公司网络需走代理时设为 1（读取系统 HTTPS_PROXY）
ZB_AI_TRUST_ENV=0

# 数据目录（数据库、照片、导出文件）
ZB_DATA_DIR=./data
ZB_PORT=8600

# 预警推送（可选）：邮件
ZB_SMTP_HOST=
ZB_SMTP_PORT=465
ZB_SMTP_SSL=1
ZB_SMTP_USER=
ZB_SMTP_PASSWORD=
ZB_SMTP_FROM=
# 预警推送（可选）：企业微信/钉钉群机器人 Webhook
ZB_WEBHOOK_URL=
# 交融语音识别模型名（如平台提供，可在交融模型列表中查找 ASR/whisper/paraformer 类模型）；留空则使用手机输入法语音
ZB_AI_ASR_MODEL=

# 开发态一键登录：设为 1 后登录页出现角色按钮，点击即登录（无需密码，仅限本机/局域网访问）。正式部署请留空或删除此行。
ZB_DEV_LOGIN=
# 开发态快捷登录只列某个项目的账号（填项目编码，如 DEMO/XX/0000/001）；留空列全部
ZB_DEV_PROJECT=

# 竞赛演示账号：填用户名（逗号分隔），这些账号登录后页面顶部可一键切换 项目经理/工程主管/安全主管 视角，不用退出重登。
# 账号本身须是这三个岗位之一（在“账号与权限”里新建）。比赛结束删掉这一项即恢复为普通账号。
ZB_DEMO_USERS=
